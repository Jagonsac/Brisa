{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteResponse",
  "description": "Respuesta de ruta más corta calculada sobre red OSM bike",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["routeGeoJson", "origin", "destination", "summary"],
      "properties": {
        "routeGeoJson": {
          "type": "object",
          "required": ["type", "geometry", "properties"],
          "properties": {
            "type": { "const": "Feature" },
            "geometry": {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "LineString" },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              }
            },
            "properties": {
              "type": "object",
              "required": ["distanceMeters", "mode", "profile"],
              "properties": {
                "distanceMeters": { "type": "number" },
                "mode": { "type": "string" },
                "profile": { "type": "string" }
              }
            }
          }
        },
        "origin": {
          "type": "object",
          "required": ["query", "displayName", "lat", "lon"],
          "properties": {
            "query": { "type": "string" },
            "displayName": { "type": "string" },
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "destination": {
          "type": "object",
          "required": ["query", "displayName", "lat", "lon"],
          "properties": {
            "query": { "type": "string" },
            "displayName": { "type": "string" },
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "summary": {
          "type": "object",
          "required": ["distanceMeters", "distanceKm"],
          "properties": {
            "distanceMeters": { "type": "number" },
            "distanceKm": { "type": "number" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["source", "graphSource", "weight", "networkType"],
      "properties": {
        "source": { "const": "osmnx" },
        "graphSource": { "type": "string", "enum": ["cache", "download"] },
        "weight": { "const": "length" },
        "networkType": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
