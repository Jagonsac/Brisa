{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRequest",
  "description": "Solicitud para calcular rutas en cuatro modos: fastest, safe, balanced y night.",
  "type": "object",
  "required": ["mode"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["fastest", "safe", "balanced", "night"],
      "description": "Perfil de coste usado por el backend de routing."
    },
    "origin": { "$ref": "#/$defs/routePoint" },
    "destination": { "$ref": "#/$defs/routePoint" },
    "originQuery": {
      "type": "string",
      "description": "Formato legacy soportado para compatibilidad."
    },
    "destinationQuery": {
      "type": "string",
      "description": "Formato legacy soportado para compatibilidad."
    }
  },
  "anyOf": [
    { "required": ["origin", "destination"] },
    { "required": ["originQuery", "destinationQuery"] }
  ],
  "$defs": {
    "routePoint": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "lat": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "lon": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "lng": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "longitude": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "latitude": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
