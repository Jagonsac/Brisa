{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRequest",
  "description": "Solicitud para calcular rutas en cuatro perfiles y opción multimodal Bicimad.",
  "type": "object",
  "required": ["mode"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["fastest", "safe", "balanced", "night"],
      "description": "Perfil de coste del tramo bici."
    },
    "useBicimad": {
      "type": "boolean",
      "description": "Activa planificación multimodal walk+bike+walk con estaciones Bicimad."
    },
    "transportMode": {
      "type": "string",
      "enum": ["bike", "bicimad"],
      "description": "Alias opcional para activar modo multimodal con bicimad."
    },
    "origin": { "$ref": "#/$defs/routePoint" },
    "destination": { "$ref": "#/$defs/routePoint" },
    "originQuery": { "type": "string" },
    "destinationQuery": { "type": "string" }
  },
  "anyOf": [
    { "required": ["origin", "destination"] },
    { "required": ["originQuery", "destinationQuery"] }
  ],
  "$defs": {
    "routePoint": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "lat": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "lon": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "lng": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "longitude": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "latitude": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
