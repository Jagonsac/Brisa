{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRequest",
  "description": "Solicitud para calcular una ruta ciclista en Madrid. Acepta formato recomendado y legado por compatibilidad.",
  "oneOf": [
    {
      "title": "RouteRequestV2",
      "type": "object",
      "required": ["origin", "destination", "mode"],
      "properties": {
        "origin": { "$ref": "#/$defs/routePoint" },
        "destination": { "$ref": "#/$defs/routePoint" },
        "mode": {
          "type": "string",
          "enum": ["fastest", "safe", "balanced", "night"],
          "description": "Slice 4 solo implementa 'fastest'"
        }
      },
      "additionalProperties": false
    },
    {
      "title": "RouteRequestLegacy",
      "type": "object",
      "required": ["originQuery", "destinationQuery", "mode"],
      "properties": {
        "originQuery": { "type": "string", "minLength": 1 },
        "destinationQuery": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["fastest", "safe", "balanced", "night"]
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "routePoint": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Texto visible en el input para trazabilidad"
        },
        "lat": {
          "type": "number",
          "description": "Latitud opcional cuando el usuario confirma una sugerencia"
        },
        "lon": {
          "type": "number",
          "description": "Longitud opcional cuando el usuario confirma una sugerencia"
        }
      },
      "allOf": [
        {
          "if": { "required": ["lat"] },
          "then": { "required": ["lon"] }
        },
        {
          "if": { "required": ["lon"] },
          "then": { "required": ["lat"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
