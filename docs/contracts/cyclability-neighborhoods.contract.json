{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyclabilityNeighborhoodListResponse",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["neighborhoodId", "name", "cyclabilityScore", "rank"],
        "properties": {
          "neighborhoodId": { "type": "string" },
          "name": { "type": "string" },
          "district": { "type": "string" },
          "cyclabilityScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "safetyScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "bikeInfraScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "lowHostilityScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "greenCyclableScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "nightScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "junctionScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "bicimadScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "dataQuality": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["fully_observed", "partially_observed", "fallbacked"] },
              "fallbacks": { "type": "array", "items": { "type": "string" } },
              "performanceFlags": { "type": "array", "items": { "type": "string" } },
              "normalizationFlags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "rank": { "type": "integer", "minimum": 1 }
          ,
          "rebalancing": {
            "type": "object",
            "properties": {
              "applied": { "type": "boolean" },
              "profile": { "type": "string" },
              "boost": { "type": "number" },
              "adjustedScore": { "type": "number", "minimum": 0, "maximum": 100 },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "meta": { "type": "object" }
  }
}
