{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafetyGridResponse",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "geometry", "properties"],
            "properties": {
              "type": { "const": "Feature" },
              "geometry": {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": { "const": "Polygon" },
                  "coordinates": { "type": "array" }
                }
              },
              "properties": {
                "type": "object",
                "required": ["safetyScore", "riskScore", "accidentCount", "explanation"]
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["version", "cellSizeMeters", "aggregationLevel", "sources", "trafficFallbackUsed"],
      "properties": {
        "version": { "type": "string" },
        "cellSizeMeters": { "type": "integer" },
        "aggregationLevel": { "type": "string", "enum": ["cell", "neighborhood"] },
        "sources": { "type": "object" },
        "trafficFallbackUsed": { "type": "boolean" }
      }
    }
  }
}
