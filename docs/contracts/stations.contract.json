{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrisaBicimadStationCollection",
  "description": "Contrato interno estable para estaciones Bicimad en frontend (Slice 2)",
  "type": "object",
  "required": ["source", "stations"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["gbfs-station-information", "emt-geojson-fallback", "local-snapshot-fallback"]
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lat", "lon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "address": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "capacity": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
